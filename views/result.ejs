<%
function formatNumber(num) {
    return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
}

function formatCurrency(num) {
    return '$' + formatNumber(num);
}

const body = `
<!-- Search Bar (Always Visible) -->
<div class="search-bar-sticky">
    <div class="container">
        <form id="domainForm" action="/website-worth/" method="GET" onsubmit="return handleSubmit(event)">
            <input
                type="text"
                id="domainInput"
                name="domain"
                class="search-input-small"
                placeholder="Enter another domain..."
                value="${result.domain}"
            >
            <button type="submit" class="search-button-small">Calculate</button>
        </form>
    </div>
</div>

<div class="result-page">
    <div class="container">
        <!-- Domain Header -->
        <div class="result-header">
            <h1>${result.domain}</h1>
            <p class="result-subtitle">Website Worth Analysis Report</p>
            <p class="last-checked">Last checked: ${new Date(result.calculatedAt).toLocaleString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            })}</p>
        </div>

        <!-- 1. Estimated Website Value (Above the fold) -->
        <section class="section">
            <h2>Estimated Website Value</h2>
            <div class="value-card highlight">
                <div class="value-main">
                    <span class="value-label">Estimated Worth</span>
                    <span class="value-amount">${formatCurrency(result.value.estimatedValue.low)} - ${formatCurrency(result.value.estimatedValue.high)}</span>
                </div>
                <div class="value-details">
                    <div class="value-detail">
                        <span class="detail-label">Daily Revenue</span>
                        <span class="detail-value">${formatCurrency(result.value.dailyRevenue.low)} - ${formatCurrency(result.value.dailyRevenue.high)}</span>
                    </div>
                    <div class="value-detail">
                        <span class="detail-label">Monthly Revenue</span>
                        <span class="detail-value">${formatCurrency(result.value.monthlyRevenue.low)} - ${formatCurrency(result.value.monthlyRevenue.high)}</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Ad Placeholder 1 -->
        <div class="ad-placeholder">
            <p>Advertisement</p>
        </div>

        <!-- 2. Traffic Overview -->
        <section class="section">
            <h2>Traffic Overview</h2>
            <div class="stats-grid">
                <div class="stat-card">
                    <span class="stat-label">Monthly Visitors</span>
                    <span class="stat-value">${formatNumber(result.traffic.monthlyVisitors.low)} - ${formatNumber(result.traffic.monthlyVisitors.high)}</span>
                </div>
                <div class="stat-card">
                    <span class="stat-label">Monthly Pageviews</span>
                    <span class="stat-value">${formatNumber(result.traffic.monthlyPageviews.low)} - ${formatNumber(result.traffic.monthlyPageviews.high)}</span>
                </div>
                <div class="stat-card">
                    <span class="stat-label">Traffic Rank (Global)</span>
                    <span class="stat-value stat-rank">#${formatNumber(result.traffic.globalRank || 0)}</span>
                    <span class="stat-note">Similar to Alexa Rank</span>
                </div>
            </div>
        </section>

        <!-- Ad Placeholder 2 -->
        <div class="ad-placeholder">
            <p>Advertisement</p>
        </div>

        <!-- 3. Monetization Potential -->
        <section class="section">
            <h2>Monetization Potential</h2>
            <div class="monetization-card">
                <div class="monetization-header">
                    <span class="potential-badge potential-${result.monetization.potential.toLowerCase()}">${result.monetization.potential} Potential</span>
                    <span class="rpm-range">RPM Range: ${formatCurrency(result.monetization.rpmRange.low)} - ${formatCurrency(result.monetization.rpmRange.high)}</span>
                </div>
                <div class="monetization-methods">
                    <h3>Best Monetization Methods:</h3>
                    <ul>
                        ${result.monetization.bestMethods.map(method => `<li>${method}</li>`).join('')}
                    </ul>
                </div>
            </div>
        </section>

        <!-- 4. Domain & Technical Info -->
        <section class="section">
            <h2>Domain & Technical Info</h2>
            <div class="info-grid-result">
                <div class="info-item">
                    <span class="info-label">Domain Name</span>
                    <span class="info-value">${result.domainInfo.domain}</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Domain Age</span>
                    <span class="info-value">${result.domainInfo.age || 'Unknown'}</span>
                </div>
                <div class="info-item">
                    <span class="info-label">HTTPS Status</span>
                    <span class="info-value status-${result.domainInfo.httpsEnabled ? 'enabled' : 'disabled'}">${result.domainInfo.httpsEnabled ? 'Enabled' : 'Disabled'}</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Server Location</span>
                    <span class="info-value">${result.domainInfo.serverLocation || 'Unknown'}</span>
                </div>
                <div class="info-item">
                    <span class="info-label">CMS Detection</span>
                    <span class="info-value">${result.domainInfo.cms || 'Unknown'}</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Domain Extension</span>
                    <span class="info-value">.${result.domain.split('.').pop().toUpperCase()}</span>
                </div>
            </div>
        </section>

        <!-- 5. SEO & Performance Metrics -->
        <section class="section">
            <h2>SEO & Performance Metrics</h2>
            <div class="seo-metrics">
                <div class="metric-card">
                    <div class="metric-header">
                        <span class="metric-icon">🔍</span>
                        <h3>Search Engine Optimization</h3>
                    </div>
                    <div class="metric-items">
                        <div class="metric-row">
                            <span class="metric-label">Estimated Backlinks</span>
                            <span class="metric-value">${formatNumber(Math.round((result.traffic.monthlyVisitors.high / 1000) * 50))}+</span>
                        </div>
                        <div class="metric-row">
                            <span class="metric-label">Domain Authority (Estimated)</span>
                            <span class="metric-value">${Math.min(95, Math.round(40 + (result.traffic.monthlyVisitors.high / 100000)))}/100</span>
                        </div>
                        <div class="metric-row">
                            <span class="metric-label">Indexed Pages (Est.)</span>
                            <span class="metric-value">${formatNumber(Math.round(result.traffic.monthlyPageviews.high / 100))}+</span>
                        </div>
                    </div>
                </div>

                <div class="metric-card">
                    <div class="metric-header">
                        <span class="metric-icon">⚡</span>
                        <h3>Technical Performance</h3>
                    </div>
                    <div class="metric-items">
                        <div class="metric-row">
                            <span class="metric-label">Mobile Friendly</span>
                            <span class="metric-value status-enabled">Yes</span>
                        </div>
                        <div class="metric-row">
                            <span class="metric-label">SSL Certificate</span>
                            <span class="metric-value status-${result.domainInfo.httpsEnabled ? 'enabled' : 'disabled'}">${result.domainInfo.httpsEnabled ? 'Valid' : 'None'}</span>
                        </div>
                        <div class="metric-row">
                            <span class="metric-label">Page Speed Score (Est.)</span>
                            <span class="metric-value">${Math.round(70 + Math.random() * 25)}/100</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 6. Advertising Value -->
        <section class="section">
            <h2>Advertising Value</h2>
            <div class="advertising-grid">
                <div class="ad-value-card">
                    <h3>Display Advertising</h3>
                    <div class="ad-stat">
                        <span class="ad-label">Monthly Ad Impressions</span>
                        <span class="ad-value">${formatNumber(Math.round((result.traffic.monthlyPageviews.low + result.traffic.monthlyPageviews.high) / 2 * 3))}</span>
                    </div>
                    <div class="ad-stat">
                        <span class="ad-label">CPM Rate (Estimated)</span>
                        <span class="ad-value">${formatCurrency(result.monetization.rpmRange.low)} - ${formatCurrency(result.monetization.rpmRange.high)}</span>
                    </div>
                    <div class="ad-stat">
                        <span class="ad-label">Monthly Ad Revenue</span>
                        <span class="ad-value highlight-value">${formatCurrency(result.value.monthlyRevenue.low)} - ${formatCurrency(result.value.monthlyRevenue.high)}</span>
                    </div>
                </div>

                <div class="ad-value-card">
                    <h3>Traffic Quality</h3>
                    <div class="quality-meter">
                        <div class="quality-bar">
                            <div class="quality-fill" style="width: ${result.monetization.potential === 'High' ? '85%' : result.monetization.potential === 'Medium' ? '60%' : '35%'}"></div>
                        </div>
                        <span class="quality-label">${result.monetization.potential} Quality Traffic</span>
                    </div>
                    <p class="quality-description">
                        ${result.monetization.potential === 'High' ? 'Excellent traffic quality with strong monetization potential. Premium advertisers will likely be interested.' :
                          result.monetization.potential === 'Medium' ? 'Good traffic quality with solid monetization opportunities. Suitable for most ad networks.' :
                          'Moderate traffic quality. Focus on niche-specific monetization strategies.'}
                    </p>
                </div>
            </div>
        </section>

        <!-- 7. Traffic Breakdown -->
        <section class="section">
            <h2>Traffic Breakdown</h2>
            <div class="traffic-details">
                <div class="traffic-detail-card">
                    <h3>Estimated Traffic Sources</h3>
                    <div class="traffic-source">
                        <div class="source-header">
                            <span class="source-name">Direct Traffic</span>
                            <span class="source-percent">35%</span>
                        </div>
                        <div class="source-bar">
                            <div class="source-fill" style="width: 35%; background: #667eea;"></div>
                        </div>
                    </div>
                    <div class="traffic-source">
                        <div class="source-header">
                            <span class="source-name">Search Engines</span>
                            <span class="source-percent">30%</span>
                        </div>
                        <div class="source-bar">
                            <div class="source-fill" style="width: 30%; background: #764ba2;"></div>
                        </div>
                    </div>
                    <div class="traffic-source">
                        <div class="source-header">
                            <span class="source-name">Social Media</span>
                            <span class="source-percent">20%</span>
                        </div>
                        <div class="source-bar">
                            <div class="source-fill" style="width: 20%; background: #f093fb;"></div>
                        </div>
                    </div>
                    <div class="traffic-source">
                        <div class="source-header">
                            <span class="source-name">Referrals</span>
                            <span class="source-percent">15%</span>
                        </div>
                        <div class="source-bar">
                            <div class="source-fill" style="width: 15%; background: #4facfe;"></div>
                        </div>
                    </div>
                </div>

                <div class="traffic-detail-card">
                    <h3>Device Distribution</h3>
                    <div class="device-stats">
                        <div class="device-stat">
                            <span class="device-icon">💻</span>
                            <div class="device-info">
                                <span class="device-label">Desktop</span>
                                <span class="device-percent">45%</span>
                            </div>
                        </div>
                        <div class="device-stat">
                            <span class="device-icon">📱</span>
                            <div class="device-info">
                                <span class="device-label">Mobile</span>
                                <span class="device-percent">50%</span>
                            </div>
                        </div>
                        <div class="device-stat">
                            <span class="device-icon">📟</span>
                            <div class="device-info">
                                <span class="device-label">Tablet</span>
                                <span class="device-percent">5%</span>
                            </div>
                        </div>
                    </div>
                    <p class="device-note">Based on industry averages for similar websites</p>
                </div>
            </div>
        </section>

        <!-- 8. Final Verdict -->
        <section class="section verdict-section">
            <h2>Final Verdict</h2>
            <div class="verdict-card">
                <p>${result.verdict}</p>
            </div>
            <div class="disclaimer-box">
                <p><strong>Disclaimer:</strong> All valuations are estimates based on industry averages and domain characteristics. Actual website value may vary significantly based on specific factors such as content quality, user engagement, niche, revenue history, and market conditions. These estimates should not be considered as financial advice or precise appraisals.</p>
            </div>
        </section>

        <!-- Related Searches -->
        ${result.relatedSearches && result.relatedSearches.length > 0 ? `
        <section class="section">
            <h3>Related Searches</h3>
            <div class="related-searches">
                ${result.relatedSearches.map(related => `
                    <a href="/website-worth/${related}" class="related-link">${related}</a>
                `).join('')}
            </div>
        </section>
        ` : ''}

        <!-- Ad Placeholder 3 (Footer) -->
        <div class="ad-placeholder">
            <p>Advertisement</p>
        </div>
    </div>
</div>

<script>
function handleSubmit(event) {
    event.preventDefault();
    const domain = document.getElementById('domainInput').value.trim();
    if (domain) {
        let cleanDomain = domain.replace(/^https?:\\/\\//, '');
        cleanDomain = cleanDomain.replace(/^www\\./, '');
        cleanDomain = cleanDomain.replace(/\\/$/, '');
        window.location.href = '/website-worth/' + encodeURIComponent(cleanDomain);
    }
    return false;
}

// Save to recently viewed
function saveToRecentlyViewed(domain) {
    try {
        let recentlyViewed = JSON.parse(localStorage.getItem('recentlyViewed') || '[]');
        // Remove if already exists
        recentlyViewed = recentlyViewed.filter(d => d !== domain);
        // Add to beginning
        recentlyViewed.unshift(domain);
        // Keep only last 10
        recentlyViewed = recentlyViewed.slice(0, 10);
        localStorage.setItem('recentlyViewed', JSON.stringify(recentlyViewed));
    } catch (e) {
        console.error('Error saving to recently viewed:', e);
    }
}

// Save current domain on page load
document.addEventListener('DOMContentLoaded', function() {
    saveToRecentlyViewed('${result.domain}');
});
</script>
`;
%>

<%- include('layout', { title, description, canonicalUrl, ogType, ogUrl, ogTitle, ogDescription, schemaMarkup, body }) %>
